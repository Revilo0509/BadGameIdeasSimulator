    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "clsx": "^2.1.1",
    "phosphor-svelte": "^3.1.1",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
